/**
 * ROFI Color theme
 * Adi1090x Type-3 Style-3 Theme
 * Author: adi1090x (adapted for NixOS)
 */

* {
    /* Import color scheme */
    bg0:     #2e344080;  /* Semi-transparent background */
    bg1:     #3b425270;  /* Semi-transparent surface */
    bg2:     #434c5e90;  /* Semi-transparent secondary */
    bg3:     #4c566aa0;  /* Semi-transparent tertiary */
    fg0:     #eceff4;
    fg1:     #e5e9f0;
    fg2:     #d8dee9;
    red:     #bf616a;
    green:   #a3be8c;
    yellow:  #ebcb8b;
    blue:    #81a1c1;
    magenta: #b48ead;
    cyan:    #88c0d0;

    accent: @blue;
    urgent: @red;
    
    background-color: transparent;
    text-color: @fg0;
    
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg0;
    location: center;
    anchor: center;
    fullscreen: true;
    width: 100%;
    height: 100%;
    x-offset: 0;
    y-offset: 0;
    transparency: "real";
}

mainbox {
    background-color: @bg0;
    children: [ inputbar, listview ];
    spacing: 25px;
    padding: 40px;
}

inputbar {
    background-color: @bg1;
    text-color: @fg0;
    border: 0;
    border-color: @accent;
    border-radius: 12px;
    padding: 16px 20px;
    spacing: 0;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    font: "Monocraft Bold 14";
    margin: 0;
    padding: 0;
}

entry {
    background-color: transparent;
    text-color: @fg0;
    font: "Monocraft 14";
    placeholder: "Search...";
    placeholder-color: @fg2;
    margin: 0 0 0 10px;
    padding: 0;
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 6;
    lines: 4;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 15px;
    margin: 10px 0 0 0;
    padding: 0;
    border: 0;
}

element {
    background-color: @bg1;
    text-color: @fg1;
    orientation: vertical;
    border-radius: 12px;
    padding: 20px 10px;
    margin: 0;
    cursor: pointer;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 48px;
    margin: 0 0 12px 0;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "Monocraft 12";
    expand: true;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    margin: 0;
    cursor: inherit;
}

element normal.normal {
    background-color: @bg1;
    text-color: @fg1;
}

element normal.urgent {
    background-color: @urgent;
    text-color: @bg0;
}

element normal.active {
    background-color: @accent;
    text-color: @bg0;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg0;
    border: 0;
    border-radius: 12px;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @bg0;
}

element selected.active {
    background-color: @accent;
    text-color: @bg0;
}

element alternate.normal {
    background-color: @bg1;
    text-color: @fg1;
}

element alternate.urgent {
    background-color: @urgent;
    text-color: @bg0;
}

element alternate.active {
    background-color: @accent;
    text-color: @bg0;
}

scrollbar {
    width: 4px;
    border: 0;
    handle-color: @accent;
    handle-width: 8px;
    padding: 0;
}

sidebar {
    border: 0;
    border-color: @accent;
    border-radius: 0;
}

button {
    margin: 0;
    padding: 0;
    color: @fg1;
    border: 0;
    border-radius: 12px;
    background-color: @bg1;
    cursor: pointer;
}

button selected {
    background-color: @accent;
    text-color: @bg0;
}

inputbar {
    spacing: 0;
    text-color: @fg0;
    padding: 2px;
    children: [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

textbox-prompt-colon {
    expand: false;
    str: " ";
    margin: 0;
    padding: 0;
}

case-indicator {
    spacing: 0;
    text-color: @fg0;
}

mode-switcher {
    spacing: 0;
}
