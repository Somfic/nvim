+
+        float weight = 1.0 - fi / float(BLUR_SAMPLES);
+        sum += texture(tex, clamp(uv + offset, 0.001, 0.999)).rgb * weight;
+        totalWeight += weight;
+    }
 
-float specularHighlight(vec2 uv) {
-    // Simulate light coming from top-left
