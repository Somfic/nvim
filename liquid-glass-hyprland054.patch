-    
-    // ========================================
-    // COMBINE ALL EFFECTS
-    // ========================================
-    
-    // Base glass color with slight tint (Apple uses a subtle blue-ish tint)
-    vec3 glassTint = vec3(0.95, 0.97, 1.0);
-    vec3 finalColor = glassColor * glassTint;
-    
-    // Add Fresnel glow (additive)
-    finalColor += fresnelColor * 0.15;
-    
-    // Add specular highlights (additive)
-    finalColor += specularColor;
-    
-    // Slight saturation reduction for glass look
-    float luminance = dot(finalColor, vec3(0.299, 0.587, 0.114));
-    finalColor = mix(vec3(luminance), finalColor, 0.9);
-    
-    // Output with glass opacity and rounded corner alpha
-    fragColor = vec4(finalColor, glassOpacity * cornerAlpha);
+
+    float sdf = evalSDF(uv);
+
+    // Rounded corner clip
+    float cornerAlpha = 1.0 - smoothstep(-AA_EDGE, AA_EDGE, sdf);
+    if (cornerAlpha < 0.001) discard;
+
+    // Depth: 0 at edge, 1 deep inside
+    float depth = clamp(-sdf / edgeThickness, 0.0, 1.0);
+    float edgeness = 1.0 - depth;
+
+    // 3D normal from SDF gradient
+    vec3 N = surfaceNormal(uv, edgeness);
+
+    // Fresnel
+    float fresnel = pow(1.0 - N.z, 5.0) * fresnelStrength;
+
+    // ---- REFRACTION ----
+    vec2 fromCenter = uv - 0.5;
+    vec2 refrOffset = -fromCenter * edgeness * edgeness * refractionStrength;
+    vec2 refractedUV = clamp(uv + refrOffset, 0.001, 0.999);
+
+    // ---- BLUR + SAMPLE BACKGROUND ----
+    vec3 blurredBg = spiralBlur(uv, texelSize, blurRadius);
+    vec3 refractedSample = spiralBlur(refractedUV, texelSize, blurRadius * 0.5);
+
+    // Blend: interior = blurred bg, edge = refracted for glass distortion
+    vec3 color = mix(blurredBg, refractedSample, edgeness);
+
+    // ---- BRIGHTNESS ----
+    color *= 0.82;
+
+    // ---- VIBRANCY ----
+    float luma = dot(color, vec3(0.299, 0.587, 0.114));
+    color = mix(vec3(luma), color, 2.0);
+
+    // ---- NOISE (stable) ----
+    float n = hash(uv * fullSize) * 2.0 - 1.0;
+    color += vec3(n * 0.05);
+
+    // ---- CHROMATIC ABERRATION ----
+    float caScale = chromaticAberration * edgeness * edgeness;
+    vec2 caDir = normalize(fromCenter + 0.0001);
+    float caR = texture(tex, clamp(refractedUV + caDir * caScale * 1.2, 0.0, 1.0)).r;
+    float caB = texture(tex, clamp(refractedUV - caDir * caScale * 0.8, 0.0, 1.0)).b;
+    color.r = mix(color.r, caR * 0.82, edgeness * 0.6);
+    color.b = mix(color.b, caB * 0.82, edgeness * 0.6);
+
+    // ---- SPECULAR ----
+    vec3 V = vec3(0.0, 0.0, 1.0);
+    vec3 L1 = normalize(vec3(-0.5, -0.6, 0.8));
+    float spec1 = pow(max(dot(N, normalize(L1 + V)), 0.0), 64.0);
+    vec3 L2 = normalize(vec3(0.5, 0.6, 0.8));
+    float spec2 = pow(max(dot(N, normalize(L2 + V)), 0.0), 96.0) * 0.4;
+    float specular = (spec1 + spec2) * specularStrength * edgeness;
+
+    // ---- COMPOSITE ----
+    color += vec3(1.0) * fresnel * 0.1;
+    color += vec3(1.0, 0.99, 0.97) * specular * 0.5;
+
+    fragColor = vec4(color, glassOpacity * cornerAlpha);
 }
