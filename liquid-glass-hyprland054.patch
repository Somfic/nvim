+vec3 surfaceNormal(vec2 uv, float edgeness) {
+    vec2 grad = sdfGradient(uv);
+    float slope = edgeness * edgeness * 3.0;
+    vec2 tilt = grad * slope;
+    return normalize(vec3(tilt, 1.0));
